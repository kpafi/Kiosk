# Startpasswort des Admins (mindestens 12 Zeichen). Legt den Admin an, solange die Datenbank
# noch keine Benutzer hat (erster Start oder Umbau auf Mehrbenutzer); danach ohne Wirkung,
# weitere Konten und neue Passwörter per python -m app.users (siehe README). Der Beispielwert
# wird abgelehnt, z. B. erzeugen mit: python3 -c 'import secrets; print(secrets.token_urlsafe(18))'
KIOSK_PASSWORD=bitte-aendern
# Benutzername des Admins beim ersten Start (Standard admin; 2 bis 32 Zeichen a-z 0-9 . _ -)
KIOSK_ADMIN_USER=admin
# Optional: Secret für Session-Cookies, mindestens 32 Zeichen. Wird sonst beim ersten Start in
# /data/secret.key erzeugt.
# KIOSK_SECRET=
# Abrufintervall der Feeds in Sekunden (Standard 900 = 15 Minuten)
KIOSK_FETCH_INTERVAL=900
# Artikel älter als so viele Tage werden gelöscht, Favoriten bleiben (Standard 90)
KIOSK_RETENTION_DAYS=90
# Zeitzone für die Ungelesen-Zähler: Sie zählen die Artikel des laufenden Tages ab 00:00 Ortszeit
# (Standard Europe/Berlin, Name aus der IANA-Zeitzonendatenbank)
KIOSK_TZ=Europe/Berlin
# Wie viele Artikelseiten gleichzeitig geladen werden (Standard 6)
KIOSK_EXTRACT_CONCURRENCY=6
# Session-Cookie nur über HTTPS (__Host-kiosk_session). Nur für lokale Entwicklung über http auf false setzen.
KIOSK_COOKIE_SECURE=true
# API-Doku unter /docs und /openapi.json (nach Login). Standard aus; nur zum Entwickeln auf 1 setzen.
# KIOSK_DOCS=0
# Optional: weitere gesperrte Ziele für Feed- und Artikelabrufe (private Adressen sind immer gesperrt),
# IPs oder Netze in CIDR-Schreibweise, kommagetrennt, z. B. die öffentlichen Adressen des eigenen Servers.
# Kein ganzes Provider-Netz (z. B. 2a01:4f8::/32): das sperrte auch dort gehostete Nachrichtenseiten.
# KIOSK_FETCH_DENY_IPS=203.0.113.10,2001:db8:1234:5678::/64
# KI-Ausgabe (zweimal täglich ein zusammenfassender Artikel aller Zeitungen über OpenRouter, Quelle kiosk).
# Ohne Schlüssel ist sie aus. Den Schlüssel nur hier eintragen, nie committen; er erscheint nie in Log oder Status.
# Nur ASCII (beim Kopieren wird aus „-“ gern ein typografischer Bindestrich; dann startet die App nicht).
# OPENROUTER_API_KEY=
# Modell (OpenRouter-Name), Endpunkt (https; http nur für localhost/127.0.0.1/[::1]) und Uhrzeiten
# (HH:MM, Ortszeit KIOSK_TZ)
# KIOSK_AI_MODEL=anthropic/claude-sonnet-5.5
# KIOSK_AI_BASE_URL=https://openrouter.ai/api/v1
# KIOSK_AI_MORNING=06:00
# KIOSK_AI_EVENING=20:00
# Denkbudget: none (Standard, nichts senden), low, medium, high. „Denkende“ Modelle (DeepSeek v4 flash, Qwen,
# GLM) verbrauchen ohne Begrenzung das ganze Token-Budget mit Denken (finish_reason length, „Antwort
# abgeschnitten“); mit low sind sie brauchbar.
# KIOSK_AI_REASONING=none
