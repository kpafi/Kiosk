# Passwort für den Login (Pflicht, mindestens 12 Zeichen). Der Beispielwert wird beim Start
# abgelehnt, z. B. erzeugen mit: python3 -c 'import secrets; print(secrets.token_urlsafe(18))'
KIOSK_PASSWORD=bitte-aendern
# Optional: Secret für Session-Cookies. Wird sonst beim ersten Start in /data/secret.key erzeugt.
# KIOSK_SECRET=
# Abrufintervall der Feeds in Sekunden (Standard 900 = 15 Minuten)
KIOSK_FETCH_INTERVAL=900
# Artikel älter als so viele Tage werden gelöscht, Favoriten bleiben (Standard 90)
KIOSK_RETENTION_DAYS=90
# Wie viele Artikelseiten gleichzeitig geladen werden (Standard 6)
KIOSK_EXTRACT_CONCURRENCY=6
# Session-Cookie nur über HTTPS (__Host-kiosk_session). Nur für lokale Entwicklung über http auf false setzen.
KIOSK_COOKIE_SECURE=true
# API-Doku unter /docs und /openapi.json (nach Login). Standard aus; nur zum Entwickeln auf 1 setzen.
# KIOSK_DOCS=0
