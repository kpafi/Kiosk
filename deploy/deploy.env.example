# Serverwerte für deploy/deploy.sh und deploy/user.sh. Kopieren nach deploy/deploy.env (git-ignoriert,
# wird nie hochgeladen) und anpassen. Wird von Bash eingelesen: KEY=wert ohne Leerzeichen um das =.
# Umgebungsvariablen gleichen Namens haben Vorrang (z. B. BOX=andere-box bash deploy/user.sh list).

# SSH-Ziel der Box: Alias aus ~/.ssh/config oder root@host. Das Skript braucht root (Caddy, Cron,
# Besitzrechte unter /opt/kiosk); Mitglied der Gruppe docker zu sein wäre ohnehin gleichwertig.
BOX=kiosk-server
# Hostname, unter dem Caddy HTTPS für Kiosk terminiert (Kleinbuchstaben, ohne https://)
KIOSK_HOST=kiosk.example.org
# Zusätzlich gesperrte Abrufziele (KIOSK_FETCH_DENY_IPS): die eigenen öffentlichen Adressen der Box,
# kommagetrennt, damit ein Feed oder Artikel nicht auf Dienste des Servers selbst zeigen kann. Wird
# in eine bestehende .env nur eingetragen, wenn der Schlüssel dort fehlt; ein vorhandener Wert bleibt.
# Kein ganzes Provider-Netz eintragen (z. B. 2001:db8::/32): das sperrte auch dort gehostete
# Nachrichtenseiten.
FETCH_DENY_IPS=203.0.113.10,2001:db8:1234:5678::/64
